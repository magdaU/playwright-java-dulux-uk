[
  {
    "name": "Ignored tests",
    "matchedStatuses": ["skipped"]
  },
  {
    "name": "Visual regression mismatch (layout changed)",
    "matchedStatuses": ["failed", "broken"],
    "messageRegex": "(?s).*Visual regression check.*"
  },
  {
    "name": "Product defects (assertion failed)",
    "matchedStatuses": ["failed"],
    "messageRegex": "(?s).*(AssertionFailedError|AssertionError|Locator expected|Page expected|expected.*but).*"
  },
  {
    "name": "Ambiguous locator (strict mode violation)",
    "matchedStatuses": ["failed", "broken"],
    "messageRegex": "(?s).*strict mode violation.*"
  },
  {
    "name": "Navigation / network problems",
    "matchedStatuses": ["failed", "broken"],
    "messageRegex": "(?s).*(net::ERR|Page closed|Target closed|Target page, context or browser has been closed|Navigation failed).*"
  },
  {
    "name": "Element not found / timeout waiting for action",
    "matchedStatuses": ["failed", "broken"],
    "messageRegex": "(?s).*(TimeoutError|Timeout \\d+ms exceeded).*"
  },
  {
    "name": "Test infrastructure problems",
    "matchedStatuses": ["broken"]
  }
]
